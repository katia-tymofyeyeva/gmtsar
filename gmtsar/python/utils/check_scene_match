#! /usr/bin/env python3
"""check_scene_match -- do two aligned-geometry NISAR SLCs show the same ground?

Compares coarse block-mean log-amplitudes of MASTER at (r, a) with REPEAT at
(r + dr, a + da) for a given integer offset (offset = repeat - master, the
pipeline's convention), on a sparse grid of blocks (reads only the sampled
blocks, so it is fast on 11 GB files). Also prints the same correlation at
shifted CONTROL offsets: a real match shows a clear peak at the given offset
and low values elsewhere; no peak anywhere means the scenes do not overlap /
the repeat's data is unusable.

Usage:  check_scene_match raw/MASTER raw/REPEAT dr da [block=200] [nblk=12]
  e.g.  check_scene_match raw/NSR_20260915A raw/NSR_20251201A -7.6 590.8
(args are the stem paths without extension; needs .PRM and .SLC for each)
"""
import sys

import numpy as np


def prm_val(path, key):
    val = None
    for line in open(path):
        if "=" in line:
            k, _, v = line.partition("=")
            if k.strip() == key and v.split():
                val = v.split()[0]
    return val


def open_slc(stem):
    nr = int(float(prm_val(stem + ".PRM", "num_rng_bins")))
    na = int(float(prm_val(stem + ".PRM", "num_patches"))) * int(float(prm_val(stem + ".PRM", "num_valid_az")))
    mm = np.memmap(stem + ".SLC", dtype="<i2", mode="r").reshape(-1, 2 * nr)
    return mm, nr, mm.shape[0]


def block_mean(mm, r0, a0, blk):
    sub = mm[a0:a0 + blk, 2 * r0:2 * (r0 + blk)].astype(np.float64)
    amp = np.hypot(sub[:, 0::2], sub[:, 1::2])
    return np.log(amp.mean() + 1.0)


def corr_at(m, nm, r, rep, nrep, dr, da, blk, centers_r, centers_a):
    a_vals, b_vals = [], []
    for ca in centers_a:
        for cr in centers_r:
            r2, a2 = cr + dr, ca + da
            if (r2 < 0 or a2 < 0 or r2 + blk > rep[1] or a2 + blk > rep[2]):
                continue
            a_vals.append(block_mean(m[0], cr, ca, blk))
            b_vals.append(block_mean(rep[0], r2, a2, blk))
    if len(a_vals) < 10:
        return np.nan, len(a_vals)
    return float(np.corrcoef(a_vals, b_vals)[0, 1]), len(a_vals)


def main():
    if len(sys.argv) < 5:
        sys.exit(__doc__)
    mstem, rstem = sys.argv[1], sys.argv[2]
    dr, da = int(round(float(sys.argv[3]))), int(round(float(sys.argv[4])))
    blk = int(sys.argv[5]) if len(sys.argv) > 5 else 200
    nblk = int(sys.argv[6]) if len(sys.argv) > 6 else 12
    m = open_slc(mstem)
    rep = open_slc(rstem)
    print(f"master {m[1]} x {m[2]}, repeat {rep[1]} x {rep[2]}; test offset (dr, da) = ({dr}, {da}); "
          f"{nblk}x{nblk} blocks of {blk}x{blk}")
    centers_r = np.linspace(blk, m[1] - 3 * blk, nblk).astype(int)
    centers_a = np.linspace(blk, m[2] - 3 * blk, nblk).astype(int)
    print("offset (dr, da)        corr   nblocks")
    for tag, (r_s, a_s) in [("GEOMETRIC", (0, 0)), ("control +1000 rng", (1000, 0)),
                            ("control +1000 azi", (0, 1000)), ("control -1000 azi", (0, -1000)),
                            ("control +30 azi", (0, 30)), ("control +300 azi", (0, 300))]:
        c, n = corr_at(m, None, None, rep, None, dr + r_s, da + a_s, blk, centers_r, centers_a)
        print(f"{tag:18s} ({dr + r_s:+6d},{da + a_s:+6d})  {c:7.3f}  {n}")


if __name__ == "__main__":
    main()
