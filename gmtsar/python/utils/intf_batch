#! /usr/bin/env python3
"""intf_batch — form a stack of interferograms from a pairs list.

Python port of csh intf_batch.csh (X. Tong + D. Sandwell 2010; A. Hogrelius
ENVI_SLC support 2017). Reads intf.in (each line "ref:rep") and runs the
single-pair workflow (intf + filter + snaphu + geocode) for each pair,
sharing topo_ra across pairs.

Usage:  intf_batch SAT intf.in batch.config

Supported SATs: ALOS, ENVI, ENVI_SLC, ERS, TSX, NSR_A, NSR_B
"""
import os
import subprocess
import sys

from gmtsar_lib import run, grep_value, check_file_report, file_shuttle, replace_strings


_SUPPORTED_SATS = {"ALOS", "ENVI", "ERS", "ENVI_SLC", "TSX", "NSR_A", "NSR_B"}


def _get_config(path, key, default=""):
    """grep <key> <path> | awk '{print $3}'."""
    with open(path) as f:
        for line in f:
            if key in line:
                parts = line.split()
                if len(parts) >= 3:
                    return parts[2]
    return default


def _topo_stage(master, SAT, topo_phase, shift_topo):
    """Stage 1: make topo_ra (+ optional topo_shift)."""
    run("cleanup topo")
    if topo_phase == 0:
        print("NO TOPOPHASE IS SUBSTRACTED")
        return
    if topo_phase != 1:
        sys.exit(f"Wrong parameter: topo_phase {topo_phase}")

    print("DEM2TOPOPHASE - START")
    os.chdir("topo")
    run(f"cp ../SLC/{master}.PRM master.PRM")
    run(f"ln -sf ../raw/{master}.LED .")
    if not check_file_report("dem.grd"):
        sys.exit("no DEM file found: dem.grd")
    run("dem2topo_ra master.PRM dem.grd")
    os.chdir("..")
    print("DEM2TOPOPHASE - END")

    if shift_topo == 0:
        print("NO TOPOPHASE SHIFT")
        return
    if shift_topo != 1:
        sys.exit(f"Wrong parameter: shift_topo {shift_topo}")

    print("OFFSET_TOPO - START")
    os.chdir("SLC")
    if SAT in ("ALOS", "TSX"):
        rng_samp_rate_raw = grep_value(f"{master}.PRM", "rng_samp_rate", 3)
        try:
            rng_samp_rate = int(float(rng_samp_rate_raw))
        except ValueError:
            sys.exit("Undefined rng_samp_rate in the master PRM file")
        if rng_samp_rate > 25_000_000:
            print("processing ALOS FBS data"); rng = 2
        else:
            print("processing ALOS FBD data"); rng = 1
        run(f"slc2amp {master}.PRM {rng} amp-{master}.grd")
    elif SAT in ("ERS", "ENVI", "ENVI_SLC"):
        run(f"slc2amp {master}.PRM 1 amp-{master}.grd")
    elif SAT in ("NSR_A", "NSR_B"):
        # No fixed decimation factor for NISAR — derive it from topo_ra.grd's
        # own x_inc, exactly as p2p_stages.py's _offset_topo_shift does (the
        # proven single-pair NSR path for this same step).
        run("gmt grdinfo ../topo/topo_ra.grd > tmp.txt")
        rng = grep_value("tmp.txt", "x_inc", 7)
        run(f"slc2amp {master}.PRM {rng} amp-{master}.grd")
        run("rm -f tmp.txt")
    else:
        sys.exit(f"OFFSET_TOPO: no amp-generation rule wired for SAT {SAT!r}")
    os.chdir("../topo")
    run(f"ln -sf ../SLC/amp-{master}.grd .")
    run(f"offset_topo amp-{master}.grd topo_ra.grd 0 0 7 topo_shift.grd")
    os.chdir("..")
    print("OFFSET_TOPO - END")


def _iono_split_scene(case_root, stem):
    """Split-spectrum ionospheric correction, added 2026-09-21 at the user's
    request (correct_iono support did not exist anywhere in intf_batch
    before this). One-time, per-SCENE step (not per-pair, unlike the
    single-pair p2p_processing/p2p_stages.py path, which only ever sees 2
    scenes at once and re-splits per pair) -- SLC_H/<stem>.SLC and
    SLC_L/<stem>.SLC, once produced, are shared by every pair referencing
    this scene. Idempotent: skips a scene already split.

    Deliberately simpler than p2p_stages.py's P2P2FocusAlign iono branch:
    that path runs split_spectrum mid-alignment, BEFORE the final resamp_py
    swap, so it has to re-derive a resample step for the high/low sub-bands
    afterward (and its generic fallback for that resample step has its own
    latent bug -- see p2p_stages.py's _iono_LH_fitoffset_and_resamp, not
    touched by this change). intf_batch only ever runs after align_batch/
    align_batch_nsr has ALREADY produced a fully-aligned, master-conforming
    SLC/<stem>.SLC -- split_spectrum is a pure range-spectral bandpass
    filter on that already-aligned complex SLC, so its SLCH/SLCL outputs
    inherit the exact same per-pixel geometry with no further resampling
    needed. This is a real design simplification made possible by
    intf_batch's stage separation, not a port of any existing tested code --
    flagged as such in PATHWAY_FORWARD.md."""
    slc_h = os.path.join(case_root, "SLC_H", f"{stem}.SLC")
    slc_l = os.path.join(case_root, "SLC_L", f"{stem}.SLC")
    slc_h_prm = os.path.join(case_root, "SLC_H", f"{stem}.PRM")
    slc_l_prm = os.path.join(case_root, "SLC_L", f"{stem}.PRM")
    # Fixed 2026-09-24: this idempotency check used to only look for the
    # .SLC files, not whether their PRMs actually carry a usable
    # radar_wavelength. Scenes split by a run from BEFORE the 2026-09-23
    # fix (which made an empty high_wavelength/low_wavelength value raise
    # loud instead of writing a blank radar_wavelength) already have their
    # SLC_H/SLC_L .SLC files on disk with a broken PRM -- so this check
    # would trust them as "already split" forever and keep reproducing the
    # exact same ZeroDivisionError on every future run, for every pair
    # that references that scene, with no way to self-heal (found on
    # NSR_20251225A/NSR_20260106A, a different scene pair than the
    # original report -- same underlying stale-PRM cause). Now also
    # validates the PRM before trusting the cache; re-splits (overwriting)
    # if it's missing or still blank.
    def _prm_has_valid_wavelength(prm_path):
        if not check_file_report(prm_path):
            return False
        wl = grep_value(prm_path, "radar_wavelength", 3)
        return isinstance(wl, (int, float)) and wl != 0

    if (check_file_report(slc_h) and check_file_report(slc_l)
            and _prm_has_valid_wavelength(slc_h_prm)
            and _prm_has_valid_wavelength(slc_l_prm)):
        print(f"IONO: {stem} already split into SLC_H/SLC_L -- skipping")
        return
    if check_file_report(slc_h) or check_file_report(slc_l):
        print(f"IONO: {stem}'s existing SLC_H/SLC_L split has an invalid "
              f"radar_wavelength (likely written by a run before the "
              f"2026-09-23 fix) -- re-splitting to repair it")
    print(f"IONO: splitting {stem} into high/low sub-bands")
    os.chdir(os.path.join(case_root, "SLC"))
    params_file = f"params_{stem}"
    run(f"split_spectrum {stem}.PRM > {params_file}")
    file_shuttle("SLCH", slc_h, "mv")
    file_shuttle("SLCL", slc_l, "mv")
    params_path = os.path.join(case_root, "SLC", params_file)
    master_prm = os.path.join(case_root, "SLC", f"{stem}.PRM")
    led_path = os.path.join(case_root, "raw", f"{stem}.LED")
    for side, key in (("SLC_H", "high_wavelength"), ("SLC_L", "low_wavelength")):
        os.chdir(os.path.join(case_root, side))
        wl = grep_value(params_path, key, 3)
        # grep_value/replace_strings never raise (matches the rest of this
        # codebase's run() tolerance), so a failed split_spectrum call or a
        # missing "{key}" line in params_path used to write silently as
        # "radar_wavelength = " (empty) -- phasediff_py's PRM parser then
        # skips the empty value, leaving lambda at its 0.0 default, which
        # only surfaces ~15 minutes later as a ZeroDivisionError deep
        # inside filter's real.grd/imag.grd step (found 2026-09-23 on real
        # NSR_20260331A/NSR_20260412A data). Fail loud here instead, right
        # where the actual cause is, per this project's no-silent-fallback
        # rule -- see PATHWAY_FORWARD.md.
        if not isinstance(wl, (int, float)) or wl == 0:
            raise RuntimeError(
                f"_iono_split_scene: could not read a usable '{key}' value "
                f"from {params_path} (got {wl!r}). This means "
                f"'split_spectrum {stem}.PRM' (run from {case_root}/SLC) "
                f"did not produce a valid {key} line -- check that command's "
                f"own output/exit code by re-running it manually before "
                f"retrying correct_iono=1."
            )
        run(f"cp {master_prm} .")
        run(f"ln -sf {led_path} .")
        replace_strings(f"{stem}.PRM", "wavelength", f"radar_wavelength = {wl}")
    os.chdir(case_root)


def _iono_one_pair(case_root, ref, rep, sub, dec, new_incx, new_incy,
                   iono_skip_est, mask_water, switch_land, topo_phase,
                   shift_topo, iono_filt_rng, iono_filt_azi, region_cut):
    """Split-spectrum ionospheric phase estimate for one pair (Gomba et al.
    2016 method, Fattahi et al. 2017 filtering -- same algorithm
    p2p_stages.py's P2P4MakeFilterInterferograms uses, reimplemented here
    against intf_batch's shared per-scene SLC_H/SLC_L rather than per-pair
    copies; see _iono_split_scene's docstring for why no resample step is
    needed here). Produces intf/<sub>/iono_phase/intf_{h,l,o}/phasefilt.grd
    always; if iono_skip_est == 0, additionally unwraps each and calls
    estimate_ionospheric_phase to produce a corrected
    intf/<sub>/phasefilt.grd (moving the uncorrected version aside as
    phasefilt_non_corrected.grd). NOT verified against real data -- new
    code, only checked with a standalone mock test (see
    bin_py/tests/test_intf_batch_iono.py)."""
    print(f"\nIONO PHASE ESTIMATE - START (pair {sub})")
    intf_sub = os.path.join(case_root, "intf", sub)
    iono_dir = os.path.join(intf_sub, "iono_phase")
    if os.path.isdir(iono_dir):
        run(f"rm -rf {iono_dir}")
    os.makedirs(iono_dir)
    for d in ("intf_h", "intf_l", "intf_o", "iono_correction"):
        os.makedirs(os.path.join(iono_dir, d), exist_ok=True)

    topo_dir = os.path.join(case_root, "topo")
    slc_dirs = {
        "intf_h": os.path.join(case_root, "SLC_H"),
        "intf_l": os.path.join(case_root, "SLC_L"),
        "intf_o": os.path.join(case_root, "SLC"),
    }
    for side in ("intf_h", "intf_l", "intf_o"):
        os.chdir(os.path.join(iono_dir, side))
        slc_dir = slc_dirs[side]
        run(f"ln -sf {slc_dir}/{ref}.LED .")
        run(f"ln -sf {slc_dir}/{rep}.LED .")
        run(f"ln -sf {slc_dir}/{ref}.SLC .")
        run(f"ln -sf {slc_dir}/{rep}.SLC .")
        run(f"cp {slc_dir}/{ref}.PRM .")
        run(f"cp {slc_dir}/{rep}.PRM .")
        if topo_phase == 1:
            topo_file = "topo_shift.grd" if shift_topo == 1 else "topo_ra.grd"
            run(f"ln -sf {topo_dir}/{topo_file} .")
            run(f"intf {ref}.PRM {rep}.PRM -topo {topo_file}")
        else:
            run(f"intf {ref}.PRM {rep}.PRM")
        run(f"filter {ref}.PRM {rep}.PRM 500 {dec} {new_incx} {new_incy}")
        file_shuttle("phase.grd", "phasefilt.grd", "cp")
        if iono_skip_est == 0:
            if mask_water == 1 or switch_land == 1:
                if not check_file_report(os.path.join(topo_dir, "landmask_ra.grd")):
                    os.chdir(topo_dir)
                    run(f"landmask {region_cut}")
                    os.chdir(os.path.join(iono_dir, side))
                run(f"ln -sf {topo_dir}/landmask_ra.grd .")
            run("snaphu_interp 0.05 0")

    if iono_skip_est == 0:
        os.chdir(os.path.join(iono_dir, "iono_correction"))
        run(f"estimate_ionospheric_phase ../intf_h ../intf_l ../intf_o "
            f"{intf_sub} {iono_filt_rng} {iono_filt_azi}")
        os.chdir(intf_sub)
        file_shuttle("phasefilt.grd", "phasefilt_non_corrected.grd", "mv")
        run(f"gmt grdsample {iono_dir}/iono_correction/ph_iono_orig.grd "
            "-Rphasefilt_non_corrected.grd -Gph_iono.grd")
        run("gmt grdmath phasefilt_non_corrected.grd ph_iono.grd SUB PI ADD "
            "2 PI MUL MOD PI SUB = phasefilt.grd")
    os.chdir(intf_sub)
    print(f"IONO PHASE ESTIMATE - END (pair {sub})")


def _intf_one_pair(ref, rep, filter_wavelen, dec, topo_phase, shift_topo,
                   threshold_snaphu, defomax, region_cut, near_interp,
                   mask_water, switch_land, threshold_geocode,
                   correct_iono=0, iono_args=None, case_root=None):
    """Per-pair work: intf + filter + snaphu + geocode in intf/<ref_id>_<rep_id>/."""
    ref_id = int(float(grep_value(f"./SLC/{ref}.PRM", "SC_clock_start", 3)))
    rep_id = int(float(grep_value(f"./SLC/{rep}.PRM", "SC_clock_start", 3)))
    sub = f"{ref_id}_{rep_id}"

    print(f"\nINTF + FILTER - START (pair {sub})")
    os.chdir("intf")
    os.makedirs(sub, exist_ok=True)
    os.chdir(sub)
    run(f"ln -sf ../../raw/{ref}.LED .")
    run(f"ln -sf ../../raw/{rep}.LED .")
    run(f"ln -sf ../../SLC/{ref}.SLC .")
    run(f"ln -sf ../../SLC/{rep}.SLC .")
    run(f"cp ../../SLC/{ref}.PRM .")
    run(f"cp ../../SLC/{rep}.PRM .")

    if topo_phase == 1:
        topo_file = "topo_shift.grd" if shift_topo == 1 else "topo_ra.grd"
        run(f"ln -sf ../../topo/{topo_file} .")
        run(f"intf {ref}.PRM {rep}.PRM -topo {topo_file}")
    else:
        run(f"intf {ref}.PRM {rep}.PRM")
    run(f"filter {ref}.PRM {rep}.PRM {filter_wavelen} {dec}")
    print("INTF + FILTER - END")

    if not region_cut:
        region_cut = subprocess.run(
            "gmt grdinfo phase.grd -I- | cut -c3-20",
            shell=True, stdout=subprocess.PIPE,
        ).stdout.decode("utf-8", "replace").strip()

    if correct_iono == 1:
        _iono_one_pair(
            case_root, ref, rep, sub, dec,
            iono_args["new_incx"], iono_args["new_incy"],
            iono_args["iono_skip_est"], mask_water, switch_land,
            topo_phase, shift_topo, iono_args["iono_filt_rng"],
            iono_args["iono_filt_azi"], region_cut,
        )

    if threshold_snaphu != 0:
        if mask_water == 1 or switch_land == 1:
            os.chdir("../../topo")
            if not check_file_report("landmask_ra.grd"):
                run(f"landmask {region_cut}")
            os.chdir(f"../intf/{sub}")
            run("ln -sf ../../topo/landmask_ra.grd .")
        print(f"\nSNAPHU - START (threshold {threshold_snaphu})")
        interp_flag = 1 if near_interp == 1 else 0
        run(f"snaphu {threshold_snaphu} {defomax} {interp_flag} {region_cut}")
        print("SNAPHU - END")
    else:
        print("SKIP UNWRAP PHASE")

    print("\nGEOCODE - START")
    run("rm -f raln.grd ralt.grd")
    if topo_phase != 1:
        sys.exit("topo_ra is needed to geocode")
    run("rm -f trans.dat")
    run("ln -sf ../../topo/trans.dat .")
    print(f"threshold_geocode: {threshold_geocode}")
    run(f"geocode {threshold_geocode}")
    print("GEOCODE - END")

    os.chdir("../..")


def intf_batch():
    if len(sys.argv) != 4:
        sys.exit(
            "Usage: intf_batch SAT intf.in batch.config\n"
            "  SAT: ALOS / ENVI / ENVI_SLC / ERS / TSX / NSR_A / NSR_B\n"
            "  intf.in: one 'ref:rep' per line"
        )
    SAT, intf_in, config = sys.argv[1], sys.argv[2], sys.argv[3]
    if SAT not in _SUPPORTED_SATS:
        sys.exit(f"SAT must be one of: {' '.join(sorted(_SUPPORTED_SATS))}")
    if not os.path.isfile(intf_in):
        sys.exit(f"no input file: {intf_in}")
    if not os.path.isfile(config):
        sys.exit(f"no config file: {config}")

    stage             = int(_get_config(config, "proc_stage", "1") or 1)
    master            = _get_config(config, "master_image")
    if not master:
        sys.exit("master image not set in config")
    filter_wavelen    = _get_config(config, "filter_wavelength", "200") or "200"
    dec               = _get_config(config, "dec_factor", "2") or "2"
    topo_phase        = int(_get_config(config, "topo_phase", "1") or 1)
    shift_topo        = int(_get_config(config, "shift_topo", "0") or 0)
    threshold_snaphu  = float(_get_config(config, "threshold_snaphu", "0") or 0)
    threshold_geocode = float(_get_config(config, "threshold_geocode", "0") or 0)
    region_cut        = _get_config(config, "region_cut", "")
    switch_land       = int(_get_config(config, "switch_land", "0") or 0)
    defomax           = int(_get_config(config, "defomax", "0") or 0)
    near_interp       = int(_get_config(config, "near_interp", "0") or 0)
    mask_water        = int(_get_config(config, "mask_water", "0") or 0)

    # correct_iono support added 2026-09-21 (see _iono_split_scene's
    # docstring) -- defaults to 0/off, at which point every line below is
    # dead code and the pair loop is byte-for-byte what it was before this
    # feature existed. Only exercised at all when a config explicitly opts in.
    correct_iono      = int(_get_config(config, "correct_iono", "0") or 0)
    iono_args = None
    case_root = os.getcwd()
    if correct_iono == 1:
        iono_filt_rng = _get_config(config, "iono_filt_rng", "200") or "200"
        iono_filt_azi = _get_config(config, "iono_filt_azi", "200") or "200"
        iono_dsamp    = int(_get_config(config, "iono_dsamp", "1") or 1)
        iono_skip_est = int(_get_config(config, "iono_skip_est", "1") or 1)
        range_dec_raw   = _get_config(config, "range_dec", "")
        azimuth_dec_raw = _get_config(config, "azimuth_dec", "")
        if not range_dec_raw or not azimuth_dec_raw:
            sys.exit(
                "[ERROR]: correct_iono=1 requires range_dec and azimuth_dec "
                "to be set in config (used to decimate the iono-specific "
                "filter step) -- neither has a sensible default for every "
                "SAT, so this fails loud rather than guessing. Add both "
                "to your config file and re-run."
            )
        new_incx = int(range_dec_raw) * iono_dsamp
        new_incy = int(azimuth_dec_raw) * iono_dsamp
        iono_args = {
            "new_incx": new_incx, "new_incy": new_incy,
            "iono_skip_est": iono_skip_est,
            "iono_filt_rng": iono_filt_rng, "iono_filt_azi": iono_filt_azi,
        }

    if stage <= 1:
        _topo_stage(master, SAT, topo_phase, shift_topo)

    if stage <= 2:
        print("\nSTART FORM A STACK OF INTERFEROGRAMS")
        os.makedirs("intf", exist_ok=True)
        with open(intf_in) as f:
            pairs = [ln.strip() for ln in f if ":" in ln]

        if correct_iono == 1:
            os.makedirs("SLC_H", exist_ok=True)
            os.makedirs("SLC_L", exist_ok=True)
            scenes = []
            for line in pairs:
                for name in line.split(":", 1):
                    if name not in scenes:
                        scenes.append(name)
            for stem in scenes:
                _iono_split_scene(case_root, stem)

        for line in pairs:
            ref, rep = line.split(":", 1)
            _intf_one_pair(
                ref, rep, filter_wavelen, dec, topo_phase, shift_topo,
                threshold_snaphu, defomax, region_cut, near_interp,
                mask_water, switch_land, threshold_geocode,
                correct_iono, iono_args, case_root,
            )
        print("\nEND FORM A STACK OF INTERFEROGRAMS")


if __name__ == "__main__":
    intf_batch()
