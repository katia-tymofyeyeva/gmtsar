#!/usr/bin/env python3
"""intf_A_on_B_grid -- Stage 2, step 1b: put the A-band interferograms on the
B-band grid, from products `filter` already made (no new intf/filter run).

B's range cell is 25 m; A's existing cells are finer (e.g. 12.5 m).  `filter`
keeps realfilt.grd, imagfilt.grd, amp1.grd, amp2.grd (it deletes only the
full-resolution real/imag).  A's Gaussian (sigma = wavelength/5.3, ~38 m for
200 m) oversamples them, so a box average over B's cell footprint in the complex
domain loses nothing.  The footprint uses the TRUE pixel ratio (B is 7.998 A
pixels wide, not 8), so the two grids stay co-located across the swath (shared
pixel 0; A/B near range identical).  Same coherence formula as `filter`.

Usage (case directory, after intf_batch and intf_batch_B):
    intf_A_on_B_grid intf.in batch.config

Output: iono_A/<ref_id>_<rep_id>/{phase,corr}.grd on B's grid (same header and
row order as iono_B/<pair>/phase.grd and corr.grd).  Resumable.  Needs netCDF4
(gmt_grd_io); ~1.5 GB RAM per pair at NISAR size.

Use these (plain multilooks), never phasefilt.grd (Goldstein), for estimation.
"""
import os
import subprocess
import sys

import numpy as np

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from gmtsar_lib import grep_value
from iono_b_lib import slc_params
from iono_est_lib import complex_on_coarse_grid
from gmt_grd_io import read_gmt_grd, write_gmt_grd


def _cfg(path, key, default=""):
    with open(path) as f:
        for ln in f:
            p = ln.split()
            if len(p) >= 3 and p[0] == key:
                return p[2]
    return default


def grd_info(path):
    """(x_inc, y_inc, nx, ny) via gmt grdinfo -C."""
    o = subprocess.run(f"gmt grdinfo -C {path}", shell=True, stdout=subprocess.PIPE
                       ).stdout.decode().split()
    return float(o[7]), float(o[8]), int(o[9]), int(o[10])


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    intf_in, config = sys.argv[1], sys.argv[2]
    master = _cfg(config, "master_image")
    if not master:
        sys.exit("master_image not set in config")
    with open(intf_in) as f:
        pairs = [ln.strip().split(":", 1) for ln in f if ":" in ln]

    def pid(s):
        return int(float(grep_value(f"SLC/{s}.PRM", "SC_clock_start", 3)))

    d_a = slc_params(f"SLC/{master}.PRM")["dr"]
    d_b = slc_params(f"SLC_B/{master[:-1]}B.PRM")["dr"]
    subs = [f"{pid(r)}_{pid(p)}" for r, p in pairs]
    print(f"{len(pairs)} pairs")

    os.makedirs("iono_A", exist_ok=True)
    for i, ((ref, rep), sub) in enumerate(zip(pairs, subs), 1):
        out = f"iono_A/{sub}"
        if os.path.isfile(f"{out}/phase.grd") and os.path.isfile(f"{out}/corr.grd"):
            print(f"[{i}/{len(pairs)}] {sub}: exists, skipped")
            continue
        src, bdir = f"intf/{sub}", f"iono_B/{sub}"
        need = [f"{src}/{f}" for f in ("realfilt.grd", "imagfilt.grd", "amp1.grd", "amp2.grd")]
        need += [f"{bdir}/phase.grd", f"{bdir}/corr.grd"]
        miss = [p for p in need if not os.path.isfile(p)]
        if miss:
            sys.exit(f"missing {miss}: needs intf_batch (A) and intf_batch_B outputs")
        ax, ay, anx, any_ = grd_info(f"{src}/realfilt.grd")
        bx, by, bnx, bny = grd_info(f"{bdir}/phase.grd")
        # A cells per B cell in range, with the TRUE pixel ratio (B/A is 7.998,
        # not 8: pairing cells in exact twos would drift ~3 A cells across the swath)
        factor = bx * d_b / d_a / ax
        if factor < 1:
            sys.exit(f"{sub}: B cell is smaller than an A cell (ratio {factor:.3f})")
        if abs(ay - by) > 1e-6 or any_ != bny:
            sys.exit(f"{sub}: azimuth grids differ: A {ay:g} x {any_}, B {by:g} x {bny}")
        print(f"[{i}/{len(pairs)}] {sub}: A {anx}x{any_} (step {ax:g}) -> B {bnx}x{bny}, {factor:.4f} A cells per B cell")

        re, _, _, _ = read_gmt_grd(f"{src}/realfilt.grd")
        im, _, _, _ = read_gmt_grd(f"{src}/imagfilt.grd")
        a1, _, _, _ = read_gmt_grd(f"{src}/amp1.grd")
        a2, _, _, _ = read_gmt_grd(f"{src}/amp2.grd")
        phase, coh = complex_on_coarse_grid(re, im, a1, a2, factor, bnx)
        del re, im, a1, a2
        # same row flip filter applies to phase.grd / corr.grd
        phase, coh = np.flipud(phase), np.flipud(coh)
        _, x, y, info = read_gmt_grd(f"{bdir}/phase.grd")
        if phase.shape != (len(y), len(x)):
            sys.exit(f"{sub}: coarsened shape {phase.shape} != B grid {(len(y), len(x))}")
        os.makedirs(out, exist_ok=True)
        for name, arr in (("phase", phase), ("corr", coh)):
            write_gmt_grd(f"{out}/{name}.grd", arr, x, y, node_offset=info["node_offset"],
                          title=f"A-band {name} on the B grid",
                          description="intf_A_on_B_grid: box average of filter's realfilt/imagfilt")
    print("\ndone: iono_A/<pair>/{phase,corr}.grd share the grid of iono_B/<pair>/")


if __name__ == "__main__":
    main()
