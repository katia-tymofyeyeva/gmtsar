#!/usr/bin/env python3
"""iono_correct_stack -- from raw per-pair dispersive estimates to the final
ionosphere-corrected products (Stages 3-5).

Usage (case directory):
    iono_correct_stack intf.in batch.config [--sigma-km 5] [--block 16]
                       [--incidence-deg 40] [--no-geocode] [--screens-ll]
                       [--preview] [--force] [--recompute]

Needs, for every pair in intf.in:
    iono_est/<pair>/{I,sigma}.grd      (iono_pair_estimate)
    intf/<pair>/{unwrap,phasefilt,phase,corr}.grd and the other step-4 products
    topo/trans.dat                      (for geocoding)

What it does
  1. block-reduce each pair's raw estimate (robust inverse-variance mean on
     block x block cells; sigma corrected for correlated cells) -> cached in
     iono_screens/coarse_pairs.npz;
  2. invert the pair network per pixel (weighted LS, one datum per pair, Huber
     IRLS against unwrapping slips) -> per-date screens relative to the master
     date (gauge; master screen = 0) with formal sigma;
  3. filter each date's screen once (quadratic trend, outlier rejection,
     gap-aware normalized Gaussian, sigma = --sigma-km);
  4. export per-date screens: iono_screens/<stem>_screen.grd (filtered),
     _sigma.grd, _raw.grd (unfiltered inversion), in radar coordinates (A pixel
     units) on the coarse grid;
  5. per pair: correction = S_f(ref) - S_f(rep), interpolated onto A's grid;
     intf_iono/<pair>/ gets  unwrap.grd = unwrap - correction,
     phasefilt.grd and phase.grd = wrap(. - correction), ph_iono.grd = the
     correction; then the existing `geocode` is run there (ph_iono.grd is
     projected to ph_iono_ll.grd by it).
The uncorrected products stay untouched in intf/<pair>/ (and their geocoded
versions from step 4).

--method sbas (or config `iono_method = sbas`): replaces 1-3 by: filter each
pair's raw estimate (the same filter: trend, outlier rejection, gap-aware
Gaussian with sigma = --sigma-km, gap filling; its sigma then includes the
fall-back-to-trend uncertainty in filled cells), then an SBAS-like time-series
inversion of the filtered estimates at every cell of their own (B-cell) grid.
The pair datums are estimated first on a subsample (every --datum-stride-th
row and column), then held fixed while the image is inverted pixel by pixel in
row chunks over --workers processes (Huber IRLS per pixel).  The screens are
not filtered again.  Step 5 is unchanged, so closure is still preserved.
Outputs go to iono_screens_sbas/ and intf_iono_sbas/ so the default results
are not overwritten; screens on the B-cell grid.  Corrected closure equals raw closure exactly, because the
correction is a difference of per-date quantities.

NOTE: a pair whose A unwrap was masked or failed has no estimate (the inversion
tolerates that if the network stays connected).  Subtracting the correction from
the unwrapped phase keeps A's cycle assignments (a re-unwrap is optional).
"""
import argparse
import os
import sys
import time

import numpy as np

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from gmtsar_lib import run, grep_value, progress

STEP = "step 7.5 screens + correction"
from iono_b_lib import slc_params, azimuth_pixel_m
from iono_est_lib import wrap
from iono_net_lib import (block_reduce, solve_network, filter_screen, interp_to_grid,
                          check_connected, invert_rows)
from gmt_grd_io import read_gmt_grd, write_gmt_grd

LINK_INPUTS = ("corr.grd", "mask.grd", "display_amp.grd", "landmask_ra.grd")
COPY_INPUTS = ("*.PRM", "*.cpt")


def _cfg(path, key, default=""):
    with open(path) as f:
        for ln in f:
            p = ln.split()
            if len(p) >= 3 and p[0] == key:
                return p[2]
    return default


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("intf_in")
    ap.add_argument("config")
    ap.add_argument("--sigma-km", type=float, default=None,
                    help="Gaussian sigma of the filter (per date for network, per pair for sbas), km (default: config iono_sigma_km, "
                         "else 5; to be tuned)")
    ap.add_argument("--block", type=int, default=None,
                    help="block size in B cells (default: config iono_block, else 16)")
    ap.add_argument("--method", choices=("network", "sbas"), default=None,
                    help="network = coarse blocks, invert, filter each date (default); sbas = filter each "
                         "pair, invert at full resolution (default: config iono_method, else network)")
    ap.add_argument("--datum-stride", type=int, default=8,
                    help="sbas: subsample stride for estimating the pair datums (default 8)")
    ap.add_argument("--fast-sigma", action="store_true",
                    help="sbas: approximate the per-date sigma (exported only) instead of inverting "
                         "every pixel's normal matrix; screens unchanged, ~2.5x faster")
    ap.add_argument("--chunk-rows", type=int, default=0,
                    help="sbas: rows per inversion task (default: automatic, ~2e7 values per worker)")
    ap.add_argument("--workers", type=int, default=None,
                    help="sbas: parallel processes for the inversion (default: config iono_workers, "
                         "else min(4, CPUs)); total memory stays about the same")
    ap.add_argument("--incidence-deg", type=float, default=40.0)
    ap.add_argument("--no-geocode", action="store_true")
    ap.add_argument("--screens-ll", action="store_true",
                    help="EXPERIMENTAL: also geocode each date's screen (full-grid upsample)")
    ap.add_argument("--preview", action="store_true")
    ap.add_argument("--force", action="store_true", help="redo pairs that already have intf_iono output")
    ap.add_argument("--recompute", action="store_true", help="ignore the cached coarse estimates")
    a = ap.parse_args()

    if a.sigma_km is None:
        a.sigma_km = float(_cfg(a.config, "iono_sigma_km", "5.0"))
    if a.block is None:
        a.block = int(_cfg(a.config, "iono_block", "16"))
    if a.method is None:
        a.method = _cfg(a.config, "iono_method", "network")
    if a.method not in ("network", "sbas"):
        sys.exit(f"iono_method must be network or sbas, got {a.method!r}")
    if a.workers is None:
        a.workers = int(_cfg(a.config, "iono_workers", "0") or 0) or min(4, os.cpu_count() or 1)
    sfx = "_sbas" if a.method == "sbas" else ""
    scr_dir, out_root = f"iono_screens{sfx}", f"intf_iono{sfx}"
    master = _cfg(a.config, "master_image")
    thr_geo = _cfg(a.config, "threshold_geocode", "0")
    wl = float(_cfg(a.config, "iono_B_filter_wavelength") or _cfg(a.config, "filter_wavelength", "200"))
    with open(a.intf_in) as f:
        pairs_txt = [ln.strip().split(":", 1) for ln in f if ":" in ln]
    if not pairs_txt:
        sys.exit("no ref:rep lines in " + a.intf_in)

    def pid(s):
        return int(float(grep_value(f"SLC/{s}.PRM", "SC_clock_start", 3)))

    dates = []
    for r, p in pairs_txt:
        for s in (r, p):
            if s not in dates:
                dates.append(s)
    gauge = dates.index(master) if master in dates else 0
    if master not in dates:
        print(f"WARNING: master {master} is not in intf.in; using {dates[0]} as the screen gauge date")
    idx = {s: k for k, s in enumerate(dates)}
    pairs = [(idx[r], idx[p]) for r, p in pairs_txt]
    subs = [f"{pid(r)}_{pid(p)}" for r, p in pairs_txt]
    D, P = len(dates), len(pairs)
    if not check_connected(pairs, D):
        sys.exit("the pair network in intf.in is not connected: some dates cannot be tied to the others")
    print(f"{D} dates, {P} pairs (redundancy {P - (D - 1)}); gauge date {dates[gauge]}")

    pa = slc_params(f"SLC/{master}.PRM")
    pb = slc_params(f"SLC_B/{master[:-1]}B.PRM")
    ratio = pb["dr"] / pa["dr"]                       # A pixels per B pixel (7.998)
    az_m = azimuth_pixel_m(f"SLC/{master}.PRM")
    sin_inc = np.sin(np.radians(a.incidence_deg))
    os.makedirs(scr_dir, exist_ok=True)
    print(f"method: {a.method}  (screens -> {scr_dir}/, corrected pairs -> {out_root}/)")

    if a.method == "sbas":
        Sf, xc, yc = sbas_screens(a, pairs, subs, dates, gauge, ratio, pb, az_m, sin_inc, scr_dir)
    else:
        Sf, xc, yc = network_screens(a, pairs, subs, dates, gauge, ratio, pb, az_m, sin_inc, wl, scr_dir)
    apply_corrections(a, pairs, subs, Sf, xc, yc, out_root, thr_geo)
    if a.screens_ll:
        geocode_screens(Sf, xc, yc, subs, dates, scr_dir)
    print("\ndone")


def write_qc(path, dates, qc):
    with open(path, "w") as f:
        f.write("ref rep n rms_z frac_z_gt3 datum_rad\n")
        for q in qc:
            f.write(f"{dates[q['pair'][0]]} {dates[q['pair'][1]]} {q['n']} {q['rms_z']:.3f} "
                    f"{q['frac_z_gt3']:.4f} {q['datum']:.3f}\n")


def print_qc(qc, dates, P, D):
    exp = (P - (D - 1)) / P
    print(f"pair residual QC (rms of standardized residuals; ~{np.sqrt(max(exp, 0)):.2f} expected "
          f"for consistent pairs, > 1.5 suspicious); worst 5 by fraction |z| > 3:")
    for q in sorted(qc, key=lambda q: -(q["frac_z_gt3"] if np.isfinite(q["frac_z_gt3"]) else -1))[:5]:
        i, j = q["pair"]
        print(f"   {dates[i][4:]}:{dates[j][4:]}  rms_z {q['rms_z']:.2f}  |z|>3 in "
              f"{q['frac_z_gt3'] * 100:.1f} %  datum {q['datum']:+.2f} rad")


def preview(Sf, dates, path):
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        D = len(dates)
        nshow = min(D, 12)
        cols = 4
        rows = (nshow + cols - 1) // cols
        fig, ax = plt.subplots(rows, cols, figsize=(16, 3.6 * rows))
        step = max(1, int(np.ceil(max(Sf.shape[1:]) / 1200)))
        lim = float(np.nanpercentile(np.abs(np.asarray(Sf[:nshow, ::step, ::step])), 98)) or 1.0
        im = None
        for k, axx in enumerate(np.ravel(ax)):
            axx.axis("off")
            if k < nshow:
                im = axx.imshow(Sf[k, ::step, ::step], vmin=-lim, vmax=lim, cmap="RdBu_r", aspect="auto")
                axx.set_title(dates[k], fontsize=8)
        fig.colorbar(im, ax=ax, shrink=0.6, label="rad (A band)")
        fig.savefig(path, dpi=80)
        plt.close(fig)
    except Exception as e:
        print(f"(preview skipped: {e})")


def sbas_screens(a, pairs, subs, dates, gauge, ratio, pb, az_m, sin_inc, scr_dir):
    """sbas method: filter each pair's raw estimate (trend, outlier rejection,
    gap-aware Gaussian, gap filling), then invert the filtered estimates for
    one screen per date at every cell (datum on a subsample, then pixel by
    pixel in row chunks, in parallel).  The screens are not filtered again.
    Returns (S, xc, yc), S a (D, ny, nx) float32 memmap."""
    import json
    D, P = len(dates), len(pairs)
    meta_f = f"{scr_dir}/stack_meta.json"
    files = {k: f"{scr_dir}/{k}.npy" for k in ("I", "sig", "S", "S_sig")}
    key = {"subs": subs, "sigma_km": a.sigma_km, "datum_stride": a.datum_stride,
           "fast_sigma": a.fast_sigma, "version": 2}
    meta = None
    if os.path.isfile(meta_f) and not a.recompute:
        with open(meta_f) as f:
            meta = json.load(f)
        if any(meta.get(k) != v for k, v in key.items()):
            meta = None
    if meta is not None and meta.get("done") and os.path.isfile(files["S"]):
        print(f"using cached screens ({files['S']}; --recompute to redo)")
        return (np.load(files["S"], mmap_mode="r"), np.asarray(meta["x"]) * ratio,
                np.asarray(meta["y"]))

    # ---- 1. filter each pair's raw estimate, stack the results (disk-backed)
    if meta is None or not meta.get("stacked") or not all(os.path.isfile(files[k]) for k in ("I", "sig")):
        I0, x, y, info = read_gmt_grd(f"iono_est/{subs[0]}/I.grd")
        ny, nx = I0.shape
        del I0
        cell_x_m = pb["dr"] * info["x_inc"] / sin_inc
        cell_y_m = az_m * info["y_inc"]
        sig_m = a.sigma_km * 1000.0
        sx, sy = sig_m / cell_x_m, sig_m / cell_y_m
        gb = 2 * P * ny * nx * 4 / 1e9
        print(f"per-pair filter: sigma {a.sigma_km:g} km = {sx:.1f} x {sy:.1f} cells "
              f"(cell {cell_x_m:.0f} x {cell_y_m:.0f} m); {P} pairs of {ny} x {nx} cells "
              f"-> {gb:.1f} GB on disk in {scr_dir}/")
        stI = np.lib.format.open_memmap(files["I"], mode="w+", dtype=np.float32, shape=(P, ny, nx))
        stS = np.lib.format.open_memmap(files["sig"], mode="w+", dtype=np.float32, shape=(P, ny, nx))
        for k, sub in enumerate(subs):
            f_i, f_s = f"iono_est/{sub}/I.grd", f"iono_est/{sub}/sigma.grd"
            if not (os.path.isfile(f_i) and os.path.isfile(f_s)):
                sys.exit(f"missing {f_i} / {f_s}: run iono_pair_estimate for every pair first")
            Ik, xk, yk, _ = read_gmt_grd(f_i)
            if Ik.shape != (ny, nx) or not (np.array_equal(xk, x) and np.array_equal(yk, y)):
                sys.exit(f"{f_i}: grid differs from {subs[0]}'s")
            sg = read_gmt_grd(f_s)[0]
            progress(STEP, f"sbas: filtering pair {sub}", k + 1, P)
            try:
                stI[k], stS[k], inl = filter_screen(Ik, sg, sy, sx, posterior_sigma=True)
            except ValueError as e:
                sys.exit(f"pair {sub}: {e}")
            n_ok = int(np.isfinite(Ik).sum())
            print(f"[{k + 1}/{P}] {sub}: {n_ok / Ik.size * 100:.1f} % of cells estimated, "
                  f"{(n_ok - int(inl.sum())) / max(n_ok, 1) * 100:.2f} % of those rejected as outliers")
            del Ik, sg, inl
        stI.flush()
        stS.flush()
        del stI, stS
        meta = dict(key, ny=ny, nx=nx, x=[float(v) for v in x], y=[float(v) for v in y],
                    node_offset=int(info["node_offset"]), stacked=True, done=False)
        with open(meta_f, "w") as f:
            json.dump(meta, f)
    ny, nx = meta["ny"], meta["nx"]
    xc = np.asarray(meta["x"]) * ratio            # A pixel units, like the network grid
    yc = np.asarray(meta["y"])
    node_offset = meta["node_offset"]
    stI = np.load(files["I"], mmap_mode="r")
    stS = np.load(files["sig"], mmap_mode="r")

    # ---- 2. pair datums from a subsample of the whole image
    st = max(1, a.datum_stride)
    t0 = time.time()
    progress(STEP, f"sbas: pair datums from a 1/{st} x 1/{st} subsample")
    sub_net = solve_network(pairs, np.asarray(stI[:, ::st, ::st]), np.asarray(stS[:, ::st, ::st]),
                            D, gauge, require_connected=True)
    datum = sub_net["c"]
    del stI, stS, sub_net
    print(f"pair datums from a 1/{st}x1/{st} subsample in {time.time() - t0:.0f} s")

    # ---- 3. full-resolution inversion, pixel by pixel, row chunks in parallel
    for k in ("S", "S_sig"):
        np.lib.format.open_memmap(files[k], mode="w+", dtype=np.float32, shape=(D, ny, nx))
    nw = max(1, int(a.workers))
    rows = a.chunk_rows or max(1, int(2e7 // (P * nx * nw)))   # same total memory for any number of workers
    paths = {"I": files["I"], "sig": files["sig"], "S_raw": files["S"], "S_sig": files["S_sig"]}
    paths = {k: os.path.abspath(v) for k, v in paths.items()}
    tasks = [(r0, min(r0 + rows, ny), pairs, D, gauge, datum, paths, not a.fast_sigma)
             for r0 in range(0, ny, rows)]
    acc = np.zeros((P, 3))
    t0 = time.time()
    print(f"full-resolution inversion: {ny} x {nx} cells, {len(tasks)} row chunks, {nw} worker(s)")
    done_rows, last = 0, 0.0
    pool = None
    if nw == 1:
        results = map(invert_rows, tasks)
    else:
        import multiprocessing as mp
        ctx = mp.get_context("fork") if "fork" in mp.get_all_start_methods() else mp.get_context()
        pool = ctx.Pool(nw)
        results = pool.imap_unordered(invert_rows, tasks)
    try:
        for r0, r1, acc_k in results:
            acc += acc_k
            done_rows += r1 - r0
            if time.time() - last > 30 or done_rows == ny:
                el = time.time() - t0
                progress(STEP, f"sbas: full-resolution inversion, rows {done_rows}/{ny} "
                         f"(~{el * (ny - done_rows) / max(done_rows, 1) / 60:.0f} min left)")
                print(f"   rows {done_rows}/{ny}  ({el:.0f} s, "
                      f"~{el * (ny - done_rows) / max(done_rows, 1):.0f} s left)", flush=True)
                last = time.time()
    finally:
        if pool is not None:
            pool.close()
            pool.join()
    qc = [{"pair": pairs[p], "n": int(acc[p, 0]),
           "rms_z": float(np.sqrt(acc[p, 1] / acc[p, 0])) if acc[p, 0] else float("nan"),
           "frac_z_gt3": float(acc[p, 2] / acc[p, 0]) if acc[p, 0] else float("nan"),
           "datum": float(datum[p])} for p in range(P)]
    print_qc(qc, dates, P, D)
    write_qc(f"{scr_dir}/pair_qc.txt", dates, qc)

    # ---- export (no further filtering)
    S = np.load(files["S"], mmap_mode="r")
    Sg = np.load(files["S_sig"], mmap_mode="r")
    for d in range(D):
        stem = dates[d]
        for name, arr in (("screen", S[d]), ("sigma", Sg[d])):
            write_gmt_grd(f"{scr_dir}/{stem}_{name}.grd", np.asarray(arr, dtype=np.float32), xc, yc,
                          node_offset=node_offset, title=f"{stem} ionospheric {name} (rad, A band)",
                          description=f"relative to {dates[gauge]}; SBAS-like inversion of per-pair "
                                      f"filtered estimates; B-cell grid, radar coords (A px)")
    print(f"screens written: {scr_dir}/<stem>_{{screen,sigma}}.grd ({D} dates; per-pair filtered "
          f"estimates inverted at full resolution, not filtered again)")
    if a.preview:
        preview(S, dates, f"{scr_dir}/screens_preview.png")
    meta["done"] = True
    with open(meta_f, "w") as f:
        json.dump(meta, f)
    return S, xc, yc


def network_screens(a, pairs, subs, dates, gauge, ratio, pb, az_m, sin_inc, wl, scr_dir):
    """Default: block-reduce, invert on the coarse grid, filter each date once."""
    D, P = len(dates), len(pairs)
    # ---------------------------------------------------- 1. block reduce ---
    cache = f"{scr_dir}/coarse_pairs.npz"
    c = None
    if os.path.isfile(cache) and not a.recompute:
        z = np.load(cache, allow_pickle=True)
        if list(z["subs"]) == subs and int(z["block"]) == a.block:
            c = {k: z[k] for k in z.files}
            print(f"using cached coarse estimates ({cache})")
    if c is None:
        Ibs, sbs = [], []
        xc = yc = None
        for k, sub in enumerate(subs):
            f_i, f_s = f"iono_est/{sub}/I.grd", f"iono_est/{sub}/sigma.grd"
            if not (os.path.isfile(f_i) and os.path.isfile(f_s)):
                sys.exit(f"missing {f_i} / {f_s}: run iono_pair_estimate for every pair first")
            progress(STEP, f"network: block-averaging pair {sub}", k + 1, P)
            I, x, y, info = read_gmt_grd(f_i)
            sg = read_gmt_grd(f_s)[0]
            cell_x_m = pb["dr"] * info["x_inc"] / sin_inc
            cell_y_m = az_m * info["y_inc"]
            sig_g = wl / 5.3
            n_ind = min(1.0, cell_x_m * cell_y_m / (4 * np.pi * sig_g ** 2))
            Ib, sb, n = block_reduce(I, sg, a.block, a.block, n_indep_per_cell=n_ind)
            Ibs.append(Ib)
            sbs.append(sb)
            if xc is None:
                nr, nc_ = Ib.shape
                xc = x[:nc_ * a.block].reshape(nc_, a.block).mean(axis=1) * ratio   # A pixel units
                yc = y[:nr * a.block].reshape(nr, a.block).mean(axis=1)
                geom = {"cell_x_m": cell_x_m, "cell_y_m": cell_y_m, "node_offset": info["node_offset"]}
            print(f"[{k + 1}/{P}] {sub}: {np.isfinite(Ib).mean() * 100:.1f} % of blocks valid")
        c = {"subs": np.array(subs), "block": a.block, "Ib": np.stack(Ibs), "sb": np.stack(sbs),
             "xc": xc, "yc": yc, "cell_x_m": geom["cell_x_m"], "cell_y_m": geom["cell_y_m"],
             "node_offset": geom["node_offset"]}
        np.savez(cache, **c)
    xc, yc = c["xc"], c["yc"]
    node_offset = int(c["node_offset"])
    block_x_m = float(c["cell_x_m"]) * a.block
    block_y_m = float(c["cell_y_m"]) * a.block

    # ------------------------------------------------------- 2. invert ---
    t0 = time.time()
    progress(STEP, f"network: inverting {P} pairs for {D} per-date screens (coarse grid)")
    net = solve_network(pairs, c["Ib"], c["sb"], D, gauge)
    print(f"network inversion done in {time.time() - t0:.0f} s")
    print_qc(net["qc"], dates, P, D)
    write_qc(f"{scr_dir}/pair_qc.txt", dates, net["qc"])

    # ------------------------------------------------------- 3. filter ---
    sig_m = a.sigma_km * 1000.0
    sx, sy = sig_m / block_x_m, sig_m / block_y_m
    print(f"per-date filter: sigma {a.sigma_km:g} km = {sx:.1f} x {sy:.1f} coarse cells "
          f"(block {block_x_m:.0f} x {block_y_m:.0f} m)")
    ny, nx = net["S"].shape[1:]
    Sf = np.zeros((D, ny, nx), dtype=np.float32)
    Sg = np.zeros((D, ny, nx), dtype=np.float32)
    for d in range(D):
        if d == gauge:
            continue
        progress(STEP, f"network: filtering the screen of {dates[d]}", d + 1, D)
        try:
            Sf[d], Sg[d], _ = filter_screen(net["S"][d], net["sigma_S"][d], sy, sx)
        except ValueError as e:
            sys.exit(f"date {dates[d]}: {e}")

    # ------------------------------------------------------ 4. export ---
    for d in range(D):
        stem = dates[d]
        for name, arr in (("screen", Sf[d]), ("sigma", Sg[d]), ("raw", net["S"][d])):
            write_gmt_grd(f"{scr_dir}/{stem}_{name}.grd", arr.astype(np.float32), xc, yc,
                          node_offset=node_offset, title=f"{stem} ionospheric {name} (rad, A band)",
                          description=f"relative to {dates[gauge]}; coarse grid, radar coords (A px)")
    print(f"screens written: {scr_dir}/<stem>_{{screen,sigma,raw}}.grd ({D} dates)")
    if a.preview:
        preview(Sf, dates, f"{scr_dir}/screens_preview.png")
    return Sf, xc, yc


def apply_corrections(a, pairs, subs, Sf, xc, yc, out_root, thr_geo):
    """Step 5 (unchanged): correction = S(ref) - S(rep) on A's grid, subtracted."""
    P = len(pairs)
    # ------------------------------------------------- 5. apply to pairs ---
    summary = []
    for k, ((i, j), sub) in enumerate(zip(pairs, subs), 1):
        src, out = f"intf/{sub}", f"{out_root}/{sub}"
        if os.path.isfile(f"{out}/unwrap_ll.grd") and not a.force:
            print(f"[{k}/{P}] {sub}: exists, skipped")
            progress(STEP, f"correcting pair {sub}: exists, skipped", k, P)
            continue
        need = [f"{src}/{n}" for n in ("unwrap.grd", "phasefilt.grd", "phase.grd", "corr.grd")]
        miss = [p for p in need if not os.path.isfile(p)]
        if miss:
            sys.exit(f"missing {miss}: needs the step-4 products of {sub}")
        print(f"[{k}/{P}] {sub}: correcting")
        progress(STEP, f"correcting pair {sub} -> {out}/", k, P)
        unw, xt, yt, uinfo = read_gmt_grd(f"{src}/unwrap.grd")
        corr = interp_to_grid(np.asarray(Sf[i]) - np.asarray(Sf[j]), xc, yc, xt, yt)
        if np.isnan(corr).any():
            print(f"   {np.isnan(corr).mean() * 100:.1f} % of cells have no correction (NaN in the output)")
        os.makedirs(out, exist_ok=True)

        def wr(name, arr):
            if os.path.lexists(f"{out}/{name}"):
                os.remove(f"{out}/{name}")
            write_gmt_grd(f"{out}/{name}", arr.astype(np.float32), xt, yt,
                          node_offset=uinfo["node_offset"])
        wr("unwrap.grd", unw - corr)
        del unw
        for name in ("phasefilt.grd", "phase.grd"):
            ph, x2, y2, _ = read_gmt_grd(f"{src}/{name}")
            if ph.shape != corr.shape or not (np.array_equal(x2, xt) and np.array_equal(y2, yt)):
                sys.exit(f"{src}/{name}: grid differs from unwrap.grd")
            wr(name, wrap(ph - corr))
        wr("ph_iono.grd", corr)
        if np.isfinite(corr).any():
            summary.append((sub, float(np.nanstd(corr)), float(np.nanmin(corr)), float(np.nanmax(corr))))

        # inputs geocode needs (read-only ones linked, small writable ones copied;
        # nothing geocode WRITES is linked, so the originals in intf/ stay untouched)
        import glob
        import shutil
        for nm in LINK_INPUTS:
            if os.path.isfile(f"{src}/{nm}") and not os.path.lexists(f"{out}/{nm}"):
                os.symlink(os.path.relpath(f"{src}/{nm}", out), f"{out}/{nm}")
        for pat in COPY_INPUTS:
            for fpath in glob.glob(f"{src}/{pat}"):
                shutil.copy(fpath, out)
        for fpath in glob.glob(f"{src}/*.LED"):
            if not os.path.lexists(f"{out}/{os.path.basename(fpath)}"):
                os.symlink(os.path.relpath(fpath, out), f"{out}/{os.path.basename(fpath)}")
        if not a.no_geocode:
            if float(thr_geo) == 0:
                print("   threshold_geocode is 0 in the config: skipping geocode")
            else:
                cwd = os.getcwd()
                os.chdir(out)
                run("rm -f raln.grd ralt.grd trans.dat")
                run("ln -sf ../../topo/trans.dat .")
                progress(STEP, f"geocoding corrected pair {sub}", k, P)
                run(f"geocode {thr_geo}")
                miss = [f for f in ("unwrap_ll.grd", "phasefilt_ll.grd", "ph_iono_ll.grd", "los_ll.grd")
                        if not os.path.isfile(f)]
                os.chdir(cwd)
                if miss:
                    print(f"   WARNING {sub}: geocode did not produce {miss}")

    if summary:
        print("\ncorrection applied (rad, A band):  pair  std  min  max")
        for s_, sd, mn, mx in summary:
            print(f"   {s_}  {sd:.2f}  {mn:+.2f}  {mx:+.2f}")


def geocode_screens(Sf, xc, yc, subs, dates, scr_dir):
    """EXPERIMENTAL --screens-ll: full-grid upsample and geocode each screen."""
    try:
        from proj_ra2ll_lib import proj_ra2ll_fast
    except ImportError as e:
        print(f"--screens-ll skipped: {e}")
        return
    unw0, xt, yt, uinfo = read_gmt_grd(f"intf/{subs[0]}/unwrap.grd")
    del unw0
    os.makedirs(f"{scr_dir}_ll", exist_ok=True)
    cwd = os.getcwd()
    os.chdir(f"{scr_dir}_ll")
    run("ln -sf ../topo/trans.dat .")
    pc = {}
    for d in range(len(dates)):
        full = interp_to_grid(np.asarray(Sf[d]), xc, yc, xt, yt)
        write_gmt_grd(f"{dates[d]}_screen_ra.grd", full, xt, yt, node_offset=uinfo["node_offset"])
        proj_ra2ll_fast("trans.dat", f"{dates[d]}_screen_ra.grd", f"{dates[d]}_screen_ll.grd", cache=pc)
        os.remove(f"{dates[d]}_screen_ra.grd")
    os.chdir(cwd)
    print(f"geocoded screens: {scr_dir}_ll/<stem>_screen_ll.grd (experimental)")


