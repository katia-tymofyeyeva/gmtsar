#! /usr/bin/env python3
"""pop_config — generate a per-case `config.py` for p2p_processing.

Reads SAT name from argv[1] and writes `./config.py` with sensible defaults.
Replaces a 252-line, 175-print() script with one template + a small per-SAT
overrides table (v1.1.5 refactor). Output is import-compatible with
p2p_processing's `from config import ...` block (every always-required
variable is emitted; SAT-specific extras are guarded by p2p_processing's
`'<name>' in dir(config)` checks).

Usage:  pop_config SAT
"""
import sys

VALID_SATS = (
    'ERS', 'ENVI', 'ENVI_SLC', 'ALOS', 'ALOS_SLC', 'ALOS2', 'ALOS2_SCAN',
    'ALOS4', 'S1_STRIP', 'S1_TOPS', 'CSK_RAW', 'CSK_SLC', 'TSX', 'RS2', 'GF3',
    'NSR_A', 'NSR_B',
)

# Per-SAT deltas vs the base defaults. Anything not listed inherits the base.
# Empty dict = pure defaults.
SAT_OVERRIDES = {
    'ALOS':       {'shift_topo': 1},
    'ALOS_SLC':   {'shift_topo': 1, 'SLC_factor': 0.02},
    'ERS':        {'shift_topo': 1},
    'ALOS2':      {'SLC_factor': 2.0},
    'ALOS2_SCAN': {'filter_wavelength': 400, 'dec_factor': 4, 'range_dec': 4, 'azimuth_dec': 8, 'det_stitch': 0},
    # ALOS-4 (L-band, launched 2024): similar to ALOS-2 SLC defaults.
    'ALOS4':      {'SLC_factor': 2.0},
    # NSR_A / NSR_B: NISAR repeat-pass interferograms (port of p2p_processing_nsr).
    # Treated similarly to ALOS_SLC for the standard P2P stages.
    #
    # Real bug found 2026-09-16, via an actual remote NISAR_CSAF run reaching
    # geocode: corr.grd came out entirely 0.0 (not NaN) for every pixel.
    # Traced through filter's correlation formula -- amp1.grd/amp2.grd (the
    # two SLCs' own amplitude images) were ~1e-11 in magnitude, so their
    # product fell below filter's hardcoded masking threshold (5e-21)
    # almost everywhere, and GMTSAR's conv smoothing turns a near-total NaN
    # mask into an all-zero output rather than propagating NaN. Root-caused
    # further back: pre_proc_nsr's own diagnostic print ("sigma of integers
    # (2048 < sig < 8192)") came out as 0, and "fraction set to 0 after
    # cast" came out at 1.93 (out of a max of 2.0, since that counter sums
    # real+imag channels) -- i.e. ~96% of every complex sample was
    # quantizing to exactly 0 during the float32->int16 cast. This old
    # SLC_factor=2.0 was carried over from ALOS-2's convention without ever
    # being calibrated against real NISAR data -- NISAR's L1 RSLC product
    # is radiometrically calibrated to real physical units, a completely
    # different (much smaller) numeric scale than ALOS-2's raw digital
    # counts. Measured directly from a real NISAR_CSAF granule: raw complex
    # std ~0.325 (both real and imag, sampled from a 2000x2000 block of
    # swaths/frequencyA/HH). GMTSAR's own quantization target is a
    # post-scaling sigma of 2048-8192 (per pre_proc_nsr's diagnostic print);
    # 0.325 * 12000 ~= 3900, comfortably inside that range (the same real
    # data suggested ~12612 for a sigma of exactly 4096 -- 12000 is a round
    # number with a bit of margin against clipping on brighter pixels).
    # NOT verified across multiple granules/incidence angles -- if a
    # different NISAR_CSAF stack still shows sigma near 0 or heavy
    # clamping after this change, this default likely needs recalibrating
    # against that data too, not assumed universal.
    'NSR_A':      {'SLC_factor': 12000.0},
    'NSR_B':      {'SLC_factor': 12000.0},
    'RS2':        {'filter_wavelength': 100},
    'TSX':        {'filter_wavelength': 100},
    'S1_TOPS':    {'spec_div': 0, 'spec_mode': 1, 'range_dec': 8, 'azimuth_dec': 2, 'det_stitch': 0},
}

BASE_DEFAULTS = {
    'shift_topo':        0,
    'filter_wavelength': 200,
    'dec_factor':        2,
}

# Always-required variables (p2p_processing fails import if any are missing).
# Values here are the universal defaults; SAT overrides may replace shift_topo,
# filter_wavelength, dec_factor.
TEMPLATE = """\
#! /usr/bin/env python3
# Generated by pop_config for SAT={sat}.
# Edit any value below to override; lines starting with '#' are comments.
# Do NOT comment out a parameter with '#' to skip it — that duplicates names.

# -------- processing stage (1: preprocess ... 6: geocode) --------
proc_stage  = 1
skip_stage  = -999
skip_1      = 0
skip_2      = 0
skip_3      = 0
skip_4      = 0
skip_5      = 0
skip_6      = 0
skip_master = 0

# -------- preprocess --------
num_patches  = -999
earth_radius = -999
near_range   = -999
fd1          = -999

# -------- focus + align --------
region_cut    = -999

# -------- topo_ra --------
topo_phase       = 1
topo_interp_mode = 0
shift_topo       = {shift_topo}

# -------- interferogram + filter --------
switch_master          = 0
filter_wavelength      = {filter_wavelength}
dec_factor             = {dec_factor}
compute_phase_gradient = 0
correct_iono           = 0
iono_filt_rng          = 1.0
iono_filt_azi          = 1.0
iono_dsamp             = 1
iono_skip_est          = 1

# -------- unwrap --------
threshold_snaphu = 0
near_interp      = 0
mask_water       = 1
defomax          = 0

# -------- geocode --------
threshold_geocode = .10
"""


def render(sat):
    cfg = dict(BASE_DEFAULTS)
    cfg.update(SAT_OVERRIDES.get(sat, {}))

    body = TEMPLATE.format(
        sat=sat,
        shift_topo=cfg['shift_topo'],
        filter_wavelength=cfg['filter_wavelength'],
        dec_factor=cfg['dec_factor'],
    )

    # Append optional vars, each guarded by p2p_processing's dir(config) check.
    extras = []
    for key in ('spec_div', 'spec_mode', 'SLC_factor', 'range_dec', 'azimuth_dec', 'det_stitch'):
        if key in cfg:
            extras.append(f'{key:22s} = {cfg[key]}')
    if extras:
        body += '\n# -------- SAT-specific extras --------\n' + '\n'.join(extras) + '\n'
    return body


def pop_config():
    """Real bug found 2026-09-01, via an actual remote batch_processing run
    (not synthetic): this used to write the generated config directly to a
    hardcoded ./config.py via open()/f.write(), ignoring stdout entirely.
    Every existing caller happened to redirect stdout to a file literally
    named config.py (this script's own docs, tests/case_runner.py's
    _stage_config), so it "worked" only by coincidence -- the real content
    came from the internal write, and the shell's `>` redirect silently
    captured nothing. batch_processing's own auto-generate-config step (used
    whenever the caller omits the trailing [config] arg) redirects to
    config.<SAT>.txt instead -- a different filename -- which exposed the
    bug: config.<SAT>.txt came out empty, and callers reading it (e.g.
    pre_proc_nsr's SLC_factor/region_cut lookup) got "" for everything.
    Not NSR-specific -- affects any SAT run through batch_processing without
    an explicit config argument. Fixed by actually writing to stdout, so
    `>` redirection means what it says for any target filename."""
    if len(sys.argv) != 2:
        sys.exit(f"Usage: pop_config SAT  (one of: {', '.join(VALID_SATS)})")
    sat = sys.argv[1]
    if sat not in VALID_SATS:
        print(f"WARNING: unrecognized SAT {sat!r}; using base defaults", file=sys.stderr)
    print(f"Generating config for {sat} -- redirect stdout to save it "
          f"(e.g. pop_config {sat} > config.py) ...", file=sys.stderr)
    sys.stdout.write(render(sat))


if __name__ == "__main__":
    pop_config()
